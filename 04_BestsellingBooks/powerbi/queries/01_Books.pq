let
    Source = Csv.Document(File.Contents(DataFolder & "books_clean.csv"), [Delimiter = ",", Columns = 40, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
    ChangedTypes = Table.TransformColumnTypes(PromotedHeaders, {
        {"entry_id", type text},
        {"list_month", type date},
        {"list_year", Int64.Type},
        {"month_number", Int64.Type},
        {"month_name", type text},
        {"year_month", type text},
        {"country", type text},
        {"coverage_group", type text},
        {"is_core", Int64.Type},
        {"list_rank", Int64.Type},
        {"top3_flag", Int64.Type},
        {"number_one_flag", Int64.Type},
        {"title", type text},
        {"author", type text},
        {"first_author", type text},
        {"is_anthology", Int64.Type},
        {"n_authors", Int64.Type},
        {"nationality", type text},
        {"nationality_raw", type text},
        {"first_author_nationality", type text},
        {"gender_raw", type text},
        {"gender_clean", type text},
        {"author_gender_group", type text},
        {"author_gender_group_order", Int64.Type},
        {"first_author_gender", type text},
        {"is_female_author", Int64.Type},
        {"is_male_author", Int64.Type},
        {"publisher", type text},
        {"publication_country", type text},
        {"publication_country_raw", type text},
        {"is_domestic_publisher", Int64.Type},
        {"publisher_origin", type text},
        {"is_domestic_author", Int64.Type},
        {"author_origin", type text},
        {"list_definition_break", Int64.Type},
        {"origin_comparable", Int64.Type},
        {"book_key", type text},
        {"entries_for_book_in_country", Int64.Type},
        {"first_seen_in_country", type date},
        {"is_new_entry", Int64.Type}
    }, "en-US")
in
    ChangedTypes
