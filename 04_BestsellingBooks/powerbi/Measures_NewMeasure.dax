// Paste ONE measure at a time: Modeling > New measure, then paste the line (name = expression).
// Format column in the guide tells you which format to apply.

// Volume | format: 0 | Chart placements (one row = one title on one monthly list)
Entries =
    COUNTROWS(Books)

// Volume | format: 0 | Entries in the five countries with a full monthly series
Core Entries =
    CALCULATE(COUNTROWS(Books), Books[is_core] = 1)

// Volume | format: 0 | Distinct title + first author
Unique Books =
    DISTINCTCOUNT(Books[book_key])

// Volume | format: 0 | Distinct first authors
Unique Authors =
    DISTINCTCOUNT(Books[first_author])

// Volume | format: 0 | Distinct list months in the current filter
Months Covered =
    DISTINCTCOUNT(Books[list_month])

// Gender | format: 0 | Entries whose authors are all women
Female Entries =
    CALCULATE(COUNTROWS(Books), Books[author_gender_group] = "Female")

// Gender | format: 0 | Entries whose authors are all men
Male Entries =
    CALCULATE(COUNTROWS(Books), Books[author_gender_group] = "Male")

// Gender | format: 0.0% | Female share of single-gender author entries (all rows)
Female Share =
    DIVIDE([Female Entries], [Female Entries] + [Male Entries])

// Gender | format: 0.0% | Same, excluding Italy before 2018 (different list definition) - use this one for trends
Female Share (Comparable) =
    CALCULATE([Female Share], Books[list_definition_break] = 0)

// Gender | format: 0.0% | Female share at rank 1
Female Share at Number One (Comparable) =
    CALCULATE([Female Share], Books[list_rank] = 1, Books[list_definition_break] = 0)

// Gender | format: 0.0% | Female share at ranks 2-10
Female Share Ranks 2-10 (Comparable) =
    CALCULATE([Female Share], Books[list_rank] > 1, Books[list_definition_break] = 0)

// Origin | format: 0 | Entries with known author nationality and comparable list definition
Origin Known Entries =
    CALCULATE(COUNTROWS(Books), Books[origin_comparable] = 1)

// Origin | format: 0 | Entries by an author from the list country
Domestic Author Entries =
    CALCULATE(COUNTROWS(Books), Books[origin_comparable] = 1, Books[author_origin] = "Domestic author")

// Origin | format: 0.0% | Share of entries by authors from the list country
Domestic Author Share =
    DIVIDE([Domestic Author Entries], [Origin Known Entries])

// Origin | format: 0.0% | Share of entries by authors from elsewhere
Foreign Author Share =
    DIVIDE(CALCULATE(COUNTROWS(Books), Books[origin_comparable] = 1, Books[author_origin] = "Foreign author"), [Origin Known Entries])

// Origin | format: 0.0% | Share published in the list country
Domestic Publisher Share =
    DIVIDE(CALCULATE(COUNTROWS(Books), Books[publisher_origin] = "Domestic publisher"), [Entries])

// Churn | format: 0.0% | Share of entries that are a title's first month on that country list
New Entry Share =
    DIVIDE(CALCULATE(COUNTROWS(Books), Books[is_new_entry] = 1), [Entries])

// Churn | format: 0 | Different books that reached #1
Distinct Number One Books =
    CALCULATE(DISTINCTCOUNT(Books[book_key]), Books[list_rank] = 1)

// Volume | format: 0.0% | Share of entries with author "[Various]"
Anthology Share =
    DIVIDE(CALCULATE(COUNTROWS(Books), Books[is_anthology] = 1), [Entries])

// Staying power | format: 0.0 | Median months a book stays on a core list (fully observed runs)
Median Months on List =
    CALCULATE(MEDIAN(BookRuns[months_on_list]), BookRuns[run_fully_observed] = 1)

// Staying power | format: 0.00 | Average months on a core list (fully observed runs)
Avg Months on List =
    CALCULATE(AVERAGE(BookRuns[months_on_list]), BookRuns[run_fully_observed] = 1)

// Staying power | format: 0.0% | Share of books that appear for just one month
Share One-Month Runs =
    DIVIDE(CALCULATE(COUNTROWS(BookRuns), BookRuns[run_fully_observed] = 1, BookRuns[months_on_list] = 1), CALCULATE(COUNTROWS(BookRuns), BookRuns[run_fully_observed] = 1))

// Concentration | format: 0.0% | Share of entries from the five biggest publishers (one value per core country)
Top 5 Publisher Share =
    AVERAGE(ConcentrationCore[top5_publisher_share])

// Concentration | format: 0 | Herfindahl index of publishers (0-10,000)
Publisher HHI =
    AVERAGE(ConcentrationCore[publisher_hhi])

// Reach | format: 0 | Authors who charted in 3 or more core countries
Authors in 3+ Core Markets =
    CALCULATE(COUNTROWS(GlobalAuthors), GlobalAuthors[core_markets] >= 3)
